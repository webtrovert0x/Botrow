# ─── Reown AppKit ───────────────────────────────────────────────────────────
# Get your Project ID from: https://cloud.reown.com
NEXT_PUBLIC_REOWN_PROJECT_ID=your_reown_project_id_here

# ─── Google Gemini AI ────────────────────────────────────────────────────────
# Get your API key from: https://aistudio.google.com/app/apikey
# Keep this PRIVATE — only use in Next.js API routes (never NEXT_PUBLIC_)
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Google Firebase ─────────────────────────────────────────────────────────
# Get all values from: Firebase Console → Project Settings → Your Apps → Web App
# Copy the exact firebaseConfig object values shown after registering your app
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abc123def456

# ─── Paystack Gateway ────────────────────────────────────────────────────────
# Get from Paystack Dashboard -> Settings -> API Keys
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key

# ─── Botrow Escrow & Treasury ────────────────────────────────────────────────
# The public address of your deployed smart contract / treasury
NEXT_PUBLIC_TREASURY_ADDRESS=0xYourTreasuryContractAddress
# The private key of the Treasury/Faucet wallet (MUST NEVER BE NEXT_PUBLIC)
FAUCET_PRIVATE_KEY=0xYourTreasuryPrivateKey
